# Supabase Configuration
# Get these values from your Supabase project dashboard: https://supabase.com/dashboard

# Supabase Project URL
SUPABASE_URL=https://your-project.supabase.co

# Supabase Anon Key (public key - safe to use in client-side code)
SUPABASE_ANON_KEY=your-anon-key

# Supabase Service Role Key (secret - never expose in client-side code)
# Only use this in server-side code
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server Configuration
PORT=3000
